    {
      "parameters": {
        "jsCode": "const input = $input.first();\nconst body = input.json.body || input.json;\n\nconst agora = new Date();\n\nconst formatarDataHora = (data) => {\n  return data.toLocaleString('pt-BR', {\n    timeZone: 'America/Recife'\n  });\n};\n\nconst criarId = () => {\n  const d = new Date();\n\n  const data = d.toLocaleDateString('pt-BR', {\n    timeZone: 'America/Recife'\n  }).replace(/\\//g, '');\n\n  const hora = d.toLocaleTimeString('pt-BR', {\n    timeZone: 'America/Recife',\n    hour: '2-digit',\n    minute: '2-digit'\n  }).replace(':', '');\n\n  const aleatorio = Math.random()\n    .toString(36)\n    .substring(2, 6)\n    .toUpperCase();\n\n  return `SOL-${data}-${hora}-${aleatorio}`;\n};\n\nreturn [{\n  json: {\n    id_solicitacao: criarId(),\n    nome_aluno: body.nome_aluno || '',\n    turma: body.turma || '',\n    data_saida: body.data_saida || '',\n    horario_saida: body.horario_saida || '',\n    responsavel: body.responsavel || '',\n    telefone: body.telefone || '',\n    motivo: body.motivo || 'Pessoal',\n    comprovante: '',\n    status: 'PENDENTE',\n    data_solicitacao: formatarDataHora(agora),\n    data_decisao: '',\n    observacao_escola: ''\n  },\n\n  binary: input.binary\n}];"
      },
