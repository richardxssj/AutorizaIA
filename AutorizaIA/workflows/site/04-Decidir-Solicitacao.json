    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\nconst id = String(body.id_solicitacao || \"\").trim();\nconst decisao = String(body.decisao || \"\").trim().toUpperCase();\nconst observacao = String(body.observacao || \"\").trim();\n\nif (!id) {\n  throw new Error(\"id_solicitacao não informado\");\n}\n\nif (![\"APROVADO\", \"RECUSADO\"].includes(decisao)) {\n  throw new Error(\"Decisão inválida\");\n}\n\nconst agora = new Date().toLocaleString(\"pt-BR\", {\n  timeZone: \"America/Recife\"\n});\n\nreturn [{\n  json: {\n    id_solicitacao: id,\n    status: decisao,\n    observacao_escola: observacao,\n    data_decisao: agora\n  }\n}];"
      },
