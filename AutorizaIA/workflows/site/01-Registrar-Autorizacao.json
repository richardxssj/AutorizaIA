    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst texto = String(body.chatInput || \"\").trim();\n\nfunction normalizarTurma(valor) {\n  const turma = String(valor || \"\")\n    .trim()\n    .toUpperCase()\n    .replace(/[-_.]/g, \" \")\n    .replace(/\\s+/g, \" \");\n\n  const m = turma.match(/^([123])\\s*(DS|ADM)\\s*([AB])$/);\n  return m ? `${m[1]} ${m[2]} ${m[3]}` : \"\";\n}\n\nfunction dataValida(valor) {\n  const m = String(valor || \"\").match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n  if (!m) return false;\n  const d = Number(m[1]), mes = Number(m[2]), a = Number(m[3]);\n  const teste = new Date(Date.UTC(a, mes - 1, d));\n  return teste.getUTCFullYear() === a && teste.getUTCMonth() === mes - 1 && teste.getUTCDate() === d;\n}\n\nfunction horarioValido(valor) {\n  const m = String(valor || \"\").match(/^(\\d{1,2}):(\\d{2})$/);\n  if (!m) return false;\n  const h = Number(m[1]), min = Number(m[2]);\n  return h >= 0 && h <= 23 && min >= 0 && min <= 59;\n}\n\nconst nome = texto.match(/Autorização para\\s+(.+?),\\s*turma/i);\nconst turma = texto.match(/turma\\s+(.+?),\\s*responsável/i);\nconst responsavel = texto.match(/responsável\\s+(.+?),\\s*data/i);\nconst data = texto.match(/data\\s+(\\d{2}\\/\\d{2}\\/\\d{4})/i);\nconst horario = texto.match(/horário\\s+(\\d{1,2}:\\d{2})/i);\nconst motivo = texto.match(/motivo\\s+(.+)$/i);\n\nconst dados = {\n  nome_aluno: nome ? nome[1].trim() : \"\",\n  turma: normalizarTurma(turma ? turma[1] : \"\"),\n  responsavel: responsavel ? responsavel[1].trim() : \"\",\n  data_saida: data ? data[1].trim() : \"\",\n  horario_saida: horario ? horario[1].trim() : \"\",\n  motivo: motivo ? motivo[1].trim() : \"\",\n  status: \"Autorizado\",\n  data_registro: new Date().toLocaleString(\"pt-BR\", { timeZone: \"America/Recife\" }),\n  sessionId: body.sessionId || \"\"\n};\n\nconst faltando = [];\nif (!dados.nome_aluno) faltando.push(\"aluno\");\nif (!dados.turma) faltando.push(\"turma válida\");\nif (!dados.responsavel) faltando.push(\"responsável\");\nif (!dados.data_saida || !dataValida(dados.data_saida)) faltando.push(\"data válida\");\nif (!dados.horario_saida || !horarioValido(dados.horario_saida)) faltando.push(\"horário válido\");\nif (!dados.motivo) faltando.push(\"motivo\");\n\ndados.valido = faltando.length === 0;\ndados.erro = dados.valido ? \"\" : `Não foi possível registrar. Verifique: ${faltando.join(\", \")}.`;\n\nreturn [{ json: dados }];"
      },
